# Copy to .env.local

# MongoDB used by BetterAuth (use the SAME database as the Express server)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=academiaconnect

# BetterAuth (generate a secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Express API + Socket.io server
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Google login (create OAuth credentials; redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: these emails become admins when they sign up
ADMIN_EMAILS=admin@academiaconnect.test

# Optional: extra origins BetterAuth should trust, comma separated (for example a Vercel preview URL)
# TRUSTED_ORIGINS=

# Optional SMTP for the password reset email (without it the link is printed in the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AcademiaConnect <no-reply@academiaconnect.test>"
