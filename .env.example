# Copy to .env.local   (Windows PowerShell: Copy-Item .env.example .env.local)

# MongoDB used by BetterAuth. Use the SAME connection string and database name as the Express server (server/.env).
# MongoDB Atlas (free): paste the string from Atlas, Connect, Drivers, for example
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
# or use a MongoDB on this computer:
MONGODB_URI=mongodb://127.0.0.1:27017
# Pick a database name of your own. The demo-data seed replaces everything inside this database.
MONGODB_DB=academiaconnect

# Optional: DNS servers to fall back on when this computer cannot look up an Atlas address (default 1.1.1.1,8.8.8.8).
# Write "system" to turn the fallback off.
# DNS_SERVERS=

# BetterAuth (generate a secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Express API + Socket.io server
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Google login (create OAuth credentials; redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: these emails become admins when they sign up
ADMIN_EMAILS=admin@academiaconnect.test

# Optional: extra origins BetterAuth should trust, comma separated (for example a Vercel preview URL)
# TRUSTED_ORIGINS=

# Optional SMTP for the password reset email (without it the link is printed in the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AcademiaConnect <no-reply@academiaconnect.test>"
